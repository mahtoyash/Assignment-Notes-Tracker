# ==============================================================================
# GSM Assignment Alert System - Configuration Template
# Copy this file to '.env' and fill in your details.
# NOTE: Never commit your actual '.env' file containing real secrets!
# ==============================================================================

# Flask Session Security Key
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Web Server Port & Host
HOST=0.0.0.0
PORT=5000

# Microsoft Azure App Registration Settings
# Register a free app at https://portal.azure.com (Azure Active Directory / Entra ID)
# Redirect URI should be set to: http://localhost:5000/callback (or your ngrok / public IP URL)
AZURE_CLIENT_ID=your-azure-app-client-id-here
AZURE_CLIENT_SECRET=your-azure-app-client-secret-here
AZURE_TENANT_ID=common

# Microsoft Graph Scopes needed for Assignments & Tasks
# Required permissions: User.Read, Tasks.Read, EduAssignments.Read (if edu account)
AZURE_SCOPES=User.Read,Tasks.Read,offline_access

# Telephony Provider & Cloud Voice API Settings:
# 'exotel' = uses Exotel India Cloud Voice API calling
# 'auto' = uses Exotel if credentials are set, otherwise falls back to Termux/PC
TELEPHONY_PROVIDER=exotel

# Exotel India Telephony Settings:
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_CALLER_ID=your_exotel_exophone_number_here
EXOTEL_FLOW_URL=https://your-ngrok-or-domain.ngrok-free.app/exotel/voice

# Telephony Mode (for local device calling fallback):
# 'auto' = auto-detects Termux on Android vs PC Simulator
# 'termux' = forces Termux API telephony
# 'simulate' = forces PC TTS simulation
TELEPHONY_MODE=auto

# Mock Mode (Set to true if testing on PC without Azure App setup yet)
ENABLE_MOCK_DATA=false

